[Unit]
Description=TRMNL Bitcoin Price Deploy Endpoint
After=network.target

[Service]
Type=simple
User=antfarm
Group=antfarm
WorkingDirectory=/home/antfarm/deployments/trmnl-btcprice
Environment="NODE_ENV=production"
Environment="DEPLOY_TOKEN=4b521be5d34f0ccffce3a92811ddc17c4257849bfca13cd52309d0e0a2f561de"
ExecStart=/usr/bin/node /home/antfarm/deployments/trmnl-btcprice/deployment/deploy-endpoint.js

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
